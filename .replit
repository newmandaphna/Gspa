# Replit configuration for The Gun Spa (Next.js 16)
modules = ["nodejs-22", "web"]
run = "npm run dev"
entrypoint = "src/app/page.tsx"
hidden = [".config", ".next", "node_modules", ".data", "tsconfig.tsbuildinfo"]

[nix]
channel = "stable-24_11"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Dev server"

[[workflows.workflow]]
name = "Dev server"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
