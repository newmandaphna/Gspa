modules = ["web", "nodejs-22", "postgresql-16"]
run = "npm run dev"
entrypoint = "src/app/page.tsx"
hidden = [".config", ".next", "node_modules", ".data", "tsconfig.tsbuildinfo"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
# The placeholder gate (src/tests/placeholders.test.ts) runs before the build. It skips itself unless
# CONTENT_FINAL=1, so deploys pass while the owner's facts are still bracketed. Once the phone, the
# bus route, the walk time, the parking line and the instructor names are real, flip the flag here:
#   build = ["sh", "-c", "npm ci && CONTENT_FINAL=1 npx vitest run src/tests/placeholders.test.ts && npm run build"]
# and a bracket or 000-0000 anywhere in site.ts or src/lib/content fails the deploy.
build = ["sh", "-c", "npm ci && npx vitest run src/tests/placeholders.test.ts && npm run build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[env]
PORT = "5000"

[workflows]
runButton = "Dev server"

[[workflows.workflow]]
name = "Dev server"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
