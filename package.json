{
  "name": "thegunspa",
  "version": "0.1.0",
  "private": true,
  "description": "The Gun Spa — luxury shooting range and private club in Jamaica, Queens. Marketing site + reservations.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-5000}",
    "media": "node scripts/media-manifest.mjs",
    "prebuild": "node scripts/media-manifest.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-5000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:setup": "playwright install chromium",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "drizzle-orm": "0.45.3",
    "lucide-react": "1.47.0",
    "motion": "13.4.2",
    "next": "16.3.6",
    "opentype.js": "^2.0.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "sharp": "^0.35.4",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "5.0.1"
  }
}
